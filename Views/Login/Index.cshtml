@model sistemaUñas_MimoraNails.Models.Usuario

@{
    ViewData["Title"] = "Iniciar Sesión";
}

<div class="container mt-5">
    <div class="row justify-content-center">
        <div class="col-md-5">

            <h1 class="text-center mb-4">Iniciar Sesión</h1>

            <form asp-action="Index" method="post">

                <div class="mb-3">
                    <label asp-for="NombreUsuario" class="form-label">
                        Usuario
                    </label>

                    <input asp-for="NombreUsuario" class="form-control" />
                </div>

                <div class="mb-3">
                    <label asp-for="Contrasena" class="form-label">
                        Contraseña
                    </label>

                    <input asp-for="Contrasena"
                           type="password"
                           class="form-control" />
                </div>

                <button type="submit" class="btn btn-primary w-100">
                    Ingresar
                </button>

            </form>

            @if (ViewBag.Error != null)
            {
                <div class="alert alert-danger mt-3">
                    @ViewBag.Error
                </div>
            }

            <div class="text-center mt-4">
                <p>¿No tenés una cuenta?</p>

                <a asp-controller="Usuarios"
                   asp-action="Create"
                   class="btn btn-outline-primary">
                    Registrarme
                </a>
            </div>

        </div>
    </div>
</div>