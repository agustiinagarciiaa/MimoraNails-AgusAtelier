@model sistemaUñas_MimoraNails.Models.Servicio

@{
    ViewData["Title"] = "Nuevo Servicio";
}

<h1>Nuevo Servicio</h1>

<form asp-action="Create" method="post">

    <div class="mb-3">
        <label asp-for="NombreServicio" class="form-label"></label>
        <input asp-for="NombreServicio" class="form-control" />
    </div>

    <div class="mb-3">
        <label asp-for="Descripcion" class="form-label"></label>
        <textarea asp-for="Descripcion" class="form-control"></textarea>
    </div>

    <div class="mb-3">
        <label asp-for="Precio" class="form-label"></label>
        <input asp-for="Precio" class="form-control" type="number" step="0.01" />
    </div>

    <div class="mb-3">
        <label asp-for="Duracion" class="form-label"></label>
        <input asp-for="Duracion" class="form-control" type="number" />
    </div>

    <button type="submit" class="btn btn-primary">
        Guardar
    </button>

    <a asp-action="Index" class="btn btn-secondary">
        Volver
    </a>

</form>