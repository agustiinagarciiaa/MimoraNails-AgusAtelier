@model sistemaUñas_MimoraNails.Models.Turno

@{
    ViewData["Title"] = "Eliminar Turno";
}

<h1>Eliminar Turno</h1>

<h3>¿Estás segura de que querés eliminar este turno?</h3>

<div>
    <hr />

    <dl class="row">

        <dt class="col-sm-3">Cliente</dt>
        <dd class="col-sm-9">
            @Model.IdClienteNavigation.Nombre
            @Model.IdClienteNavigation.Apellido
        </dd>

        <dt class="col-sm-3">Servicio</dt>
        <dd class="col-sm-9">
            @Model.IdServicioNavigation.NombreServicio
        </dd>

        <dt class="col-sm-3">Fecha</dt>
        <dd class="col-sm-9">
            @Model.FechaTurno
        </dd>

        <dt class="col-sm-3">Hora</dt>
        <dd class="col-sm-9">
            @Model.HoraTurno
        </dd>

        <dt class="col-sm-3">Estado</dt>
        <dd class="col-sm-9">
            @Model.Estado
        </dd>

    </dl>

    <form asp-action="Delete" method="post">
        <input type="hidden" asp-for="IdTurno" />

        <button type="submit" class="btn btn-danger">
            Sí, eliminar
        </button>

        <a asp-action="Index" class="btn btn-secondary">
            Cancelar
        </a>
    </form>
</div>